HOST=0.0.0.0
PORT=8000
WORKSPACE_DIR=workspace
MAX_CONCURRENT_JOBS=2

# Whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Speaker diarization — get free token at https://huggingface.co/settings/tokens
# Accept terms at https://hf.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# TTS backend: coqui | elevenlabs
TTS_BACKEND=coqui
ELEVENLABS_API_KEY=

# Translation backend: deep_translator | openai | deepl
TRANSLATION_BACKEND=deep_translator
OPENAI_API_KEY=
DEEPL_API_KEY=

# Wav2Lip (advanced lip-sync) — requires manual setup, see README
WAV2LIP_ENABLED=false
WAV2LIP_CHECKPOINT_PATH=models/wav2lip/wav2lip_gan.pth
WAV2LIP_PYTHON_PATH=python

MAX_UPLOAD_SIZE_MB=500
